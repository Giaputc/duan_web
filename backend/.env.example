# ===== Cấu hình môi trường cho HRMS Backend =====
# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env

# Cổng API
PORT=3000

# Kết nối SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStr0ngPwd!
DB_NAME=hrms

# Bí mật ký JWT — bắt buộc, sinh ngẫu nhiên bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# URL frontend để redirect (OAuth, email khôi phục)
FRONTEND_URL=http://localhost:5173

# Google OAuth — để trống thì chỉ tắt đăng nhập Google, backend vẫn chạy bình thường
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail gửi email khôi phục mật khẩu (App Password, không phải mật khẩu thường)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# (Tùy chọn) Email của tài khoản admin do `pnpm run seed` tạo
SEED_ADMIN_EMAIL=admin@hrms.local

# (Tùy chọn) Giới hạn request — chỉnh khi dev cho đỡ khó chịu
RATE_LIMIT_DANG_NHAP=20
RATE_LIMIT_KIEM_TRA_TEN=60
